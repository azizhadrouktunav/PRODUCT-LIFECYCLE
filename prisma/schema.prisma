generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String @id
  name        String
  description String @default("")

  @@map("products")
}

model Actor {
  id          String   @id
  name        String
  description String   @default("")
  productIds  String[] @default([]) @map("product_ids")

  @@map("actors")
}

model Lifecycle {
  id             String            @id
  label          String
  summary        String            @default("")
  decomposition  String
  stages         Json              @default("[]")
  storyStages    Json              @default("[]") @map("story_stages")
  groups         CapabilityGroup[]

  @@map("lifecycles")
}

model CapabilityGroup {
  id           String       @id
  name         String
  description  String       @default("")
  /** Short unique token used in capability IDs (e.g. S → CAP-S-0001). */
  code         String       @unique
  track        String
  lifecycle    Lifecycle    @relation(fields: [track], references: [id], onDelete: Restrict)
  process      String       @default("")
  capabilities Capability[]

  @@index([track])
  @@map("capability_groups")
}

model EquipmentType {
  id   String @id
  name String @unique

  @@map("equipment_types")
}

model Equipment {
  id     String @id
  name   String
  vendor String @default("")
  model  String @default("")
  type   String @default("")

  @@map("equipment")
}

model Capability {
  id           String          @id
  name         String
  description  String          @default("")
  groupId      String          @map("group_id")
  group        CapabilityGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  productIds   String[]        @default([]) @map("product_ids")
  jiraEpic     String          @default("") @map("jira_epic")
  equipmentIds String[]        @default([]) @map("equipment_ids")
  progress     String          @default("Identified")
  status       String?
  epics        Epic[]

  @@index([groupId])
  @@map("capabilities")
}

model Epic {
  id           String     @id
  capabilityId String     @map("capability_id")
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  key          String     @default("")
  name         String
  description  String     @default("")
  status       String?
  features     Feature[]

  @@index([capabilityId])
  @@map("epics")
}

model Feature {
  id          String      @id
  epicId      String      @map("epic_id")
  epic        Epic        @relation(fields: [epicId], references: [id], onDelete: Cascade)
  name        String
  description String      @default("")
  status      String?
  stories     UserStory[]

  @@index([epicId])
  @@map("features")
}

model UserStory {
  id              String   @id
  featureId       String   @map("feature_id")
  feature         Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  title           String
  role            String   @default("")
  actorIds        String[] @default([]) @map("actor_ids")
  want            String   @default("")
  benefit         String   @default("")
  criteria        String[] @default([])
  points          Int?
  status          String?
  stage           String   @default("In UI/UX Design")
  adrContext      String   @default("") @map("adr_context")
  adrDecision     String   @default("") @map("adr_decision")
  adrTechnical    String   @default("") @map("adr_technical")
  adrConsequences String   @default("") @map("adr_consequences")
  adrApproved     Boolean  @default(false) @map("adr_approved")

  @@index([featureId])
  @@map("user_stories")
}

model Wave {
  id           String    @id
  code         String    @default("")
  name         String
  description  String    @default("")
  state        String    @default("Planned")
  deliveryDate DateTime? @db.Date @map("delivery_date")
  itemIds      String[]  @default([]) @map("item_ids")

  @@map("waves")
}

model AppRole {
  slug             String              @id
  label            String
  description      String              @default("")
  seesAllProducts  Boolean             @default(false) @map("sees_all_products")
  isSystem         Boolean             @default(false) @map("is_system")
  permissions      AppRolePermission[]
  profiles         AppProfile[]

  @@map("app_roles")
}

model AppRolePermission {
  roleSlug String  @map("role_slug")
  action   String
  role     AppRole @relation(fields: [roleSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleSlug, action])
  @@map("app_role_permissions")
}

model AppProfile {
  userId      String   @id @map("user_id") @db.Uuid
  email       String   @default("")
  displayName String   @default("") @map("display_name")
  role        String
  appRole     AppRole  @relation(fields: [role], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  productIds  String[] @default([]) @map("product_ids")
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_profiles")
}

model AppUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String?        @map("password_hash")
  disabled     Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(6)
  profile      AppProfile?
  tokens       AppUserToken[]
  sessions     AppSession[]

  @@map("app_users")
}

model AppUserToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  kind      String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("app_user_tokens")
}

model AppSession {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("app_sessions")
}
