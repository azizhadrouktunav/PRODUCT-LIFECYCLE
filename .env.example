VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role (server / scripts only — never expose to Vite client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First administrator (npm run seed:admin)
SEED_ADMIN_EMAIL=admin@tunav.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator

# Edge Function secrets — set them on the project, not in this file:
#   npx supabase secrets set RESEND_API_KEY=... RESEND_FROM=... APP_BASE_URL=...
RESEND_API_KEY=re_your_api_key
RESEND_FROM="TUNAV ONE <noreply@your-verified-domain.com>"
APP_BASE_URL=https://tunav-ref.vercel.app

# Prisma → Supabase (replace PASSWORD with URL-encoded database password)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
