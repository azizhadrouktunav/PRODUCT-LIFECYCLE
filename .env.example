VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role (server / scripts only — never expose to Vite client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First administrator (npm run seed:admin)
SEED_ADMIN_EMAIL=admin@tunav.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator

# EmailJS (https://dashboard.emailjs.com) sends invite and reset mails from the
# browser, so these three are public by design — the private key must never be
# used here. The connected EmailJS service owns the From address
# (aziz.hadrouk@tunav.com); the template maps To Email to {{to_email}},
# Subject to {{subject}} and its content to {{{html}}}.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_REPLY_TO=aziz.hadrouk@tunav.com

# Edge Function secrets — set them on the project, not in this file:
#   npx supabase secrets set APP_BASE_URL=... --project-ref <project-ref>
#   npx supabase secrets set SUPABASE_JWT_SECRET=... --project-ref <project-ref>
# APP_BASE_URL is the origin baked into every set-password link the functions
# hand back. SUPABASE_JWT_SECRET (Dashboard → Settings → API → JWT Settings)
# signs the one-hour access token the browser sends to PostgREST, which is what
# the RLS policies identify the user by.
APP_BASE_URL=https://tunav-ref.vercel.app

# Prisma → Supabase (replace PASSWORD with URL-encoded database password)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
